{
  "name": "arconti31",
  "version": "1.0.0",
  "description": "Menù digitale ristorante/bar con CMS custom su Cloudflare Workers",
  "scripts": {
    "build:data": "node scripts/generate-json.js",
    "validate": "node scripts/validate-content.js",
    "build:static": "node scripts/build-cloudflare.mjs",
    "build": "npm run validate && npm run build:data && npm run build:static",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "types:worker": "wrangler types",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test:worker": "vitest run",
    "backfill:stable-refs": "node scripts/backfill-stable-refs.js",
    "dev": "python -m http.server 8000"
  },
  "keywords": [
    "cloudflare-workers",
    "headless-cms",
    "restaurant",
    "beer-menu"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
