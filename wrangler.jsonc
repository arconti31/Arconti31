/**
 * Configurazione Cloudflare Workers + Static Assets per Arconti31.
 * Schema: node_modules/wrangler/config-schema.json
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arconti31",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-07-24",
	// nodejs_compat: il worker usa node:crypto (HMAC/SHA-1) e Buffer
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		// dist/ generata da scripts/build-cloudflare.mjs (allowlist esplicita)
		"directory": "./dist",
		"binding": "ASSETS",
		// Il Worker gira PRIMA degli asset solo su questi path:
		// - /api/*                → endpoint backend
		// - /.netlify/functions/* → alias legacy temporanei (inoltro interno)
		//
		// /admin/* NON è qui di proposito: gli asset del pannello (JS, CSS, icone)
		// devono essere serviti direttamente dagli Static Assets, che sono gratuiti
		// e non consumano richieste Worker. Con not_found_handling di default
		// ("none") un path /admin senza asset corrispondente arriva comunque al
		// Worker, che decide se fare fallback SPA (vedi isSpaNavigation in router.ts).
		"run_worker_first": ["/api/*", "/.netlify/functions/*"]
	},
	"observability": {
		"enabled": true
	}
	// Secrets (mai in questo file): GITHUB_TOKEN, ADMIN_PASSWORD, CMS_TOKEN_SECRET,
	// CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET → `wrangler secret put <NAME>`
	// Vars non segrete impostabili via dashboard o `vars`: REPO_OWNER, REPO_NAME,
	// GITHUB_BRANCH, ADMIN_EMAIL, CLOUDINARY_CLOUD_NAME, CLOUDINARY_UPLOAD_PRESET,
	// CLOUDINARY_FOLDER, ALLOWED_ORIGINS
}
