# ============================================================
# Arconti31 — template variabili ambiente
# ============================================================
# Questo file è un ESEMPIO senza secret reali.
# Copia in .env.local (gitignored) per lo sviluppo locale con wrangler
# (oppure usa .dev.vars, vedi .dev.vars.example).
#
# In produzione (Cloudflare):
# Secret:  npx wrangler secret put <NOME>
# Variabili: dashboard → Workers → arconti31 → Settings → Variables
# ============================================================

# --- GitHub (repo del cliente) ---
REPO_OWNER=arconti31
REPO_NAME=Arconti31
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Login CMS (/admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Segreto usato per firmare le sessioni CMS (dedicato, non riusare la password)
CMS_TOKEN_SECRET=change-me-long-random-secret-at-least-32-chars

# --- Cloudinary (upload immagini) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
CLOUDINARY_FOLDER=arconti31
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Opzionale ---
# ALLOWED_ORIGINS=https://arconti31.com,https://www.arconti31.com
